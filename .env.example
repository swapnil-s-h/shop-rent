NODE_ENV=development
PORT=3000

# Local Postgres (create the database first: createdb shop_rent)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_rent

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters-aaaa
JWT_REFRESH_SECRET=replace-me-with-at-least-32-random-characters-bbbb

# test | live. Live is only accepted when NODE_ENV=production.
PAYMENT_ENV=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=replace-me@replace-me.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
